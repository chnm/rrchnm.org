	/essay/arguing-with-digital-history-working-group-digital-history-and-argument-white-paper /publications/digital-history-and-argument-white-paper/
	/essay/arguing-with-digital-history-working-group-digital-history-and-argument-white-paper/ /publications/digital-history-and-argument-white-paper/
	/essays/using-technology-making-history-a-collaborative-experiment-in-interdisciplinary-teaching-and-scholarship /publications/using-technology-making-history-a-collaborative-experiment-in-interdisciplinary-eaching-and-scholarship/
	/essays/using-technology-making-history-a-collaborative-experiment-in-interdisciplinary-teaching-and-scholarship/ /publications/using-technology-making-history-a-collaborative-experiment-in-interdisciplinary-eaching-and-scholarship/
	/essay/using-technology-making-history-a-collaborative-experiment-in-interdisciplinary-teaching-and-scholarship /publications/using-technology-making-history-a-collaborative-experiment-in-interdisciplinary-eaching-and-scholarship/
