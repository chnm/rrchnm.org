# Fire the exact-path redirect when the map produced a target. Emitted first so
# these one-off mappings win over the section patterns that follow.
@hasRedirect expression `{redirect_target} != ""`
redir @hasRedirect {redirect_target} 301

# --- Feeds: any WordPress feed -> the blog feed ---
@feeds path_regexp ^/(.*/)?feed/?$
redir @feeds /blog/index.xml 301

# --- WordPress sitemaps -> Hugo sitemap ---
@wpsitemap path_regexp ^/wp-sitemap[^/]*\.xml$
redir @wpsitemap /sitemap.xml 301

# --- News + events archive and pagination -> blog listing ---
# (Must precede the /news/<slug> rule so /news/page/N/ is not treated as a slug.)
@newslist path_regexp ^/(news|news-events)(/page/[0-9]+)?/?$
redir @newslist /blog/ 301

# --- News posts -> blog (slug preserved) ---
@news path_regexp news ^/news/([^/]+)/?$
redir @news /blog/{re.news.1}/ 301

# --- Research & Tools posts -> blog (slug preserved) ---
@researchtools path_regexp researchtools ^/research-and-tools/([^/]+)/?$
redir @researchtools /blog/{re.researchtools.1}/ 301

# --- Essays (singular or plural) -> publications (slug preserved) ---
@essays path_regexp essays ^/essays?/([^/]+)/?$
redir @essays /publications/{re.essays.1}/ 301

# --- About-RRCHNM posts (blog announcements) -> blog listing ---
# (Bare /about-rrchnm/ is handled by the map above -> /our-story/.)
@aboutrrchnm path_regexp ^/about-rrchnm/.+
redir @aboutrrchnm /blog/ 301

# --- Other legacy news-ish sections -> blog listing ---
@blogish path_regexp ^/(funders-awards|sidelights|events|episodes)(/.*)?$
redir @blogish /blog/ 301

# --- Old date-based archives -> blog listing ---
@datearchive path_regexp ^/(19|20)[0-9]{2}(/.*)?$
redir @datearchive /blog/ 301

# --- Author archives -> blog listing (Hugo has no author taxonomy) ---
@author path_regexp ^/author/.+
redir @author /blog/ 301

# --- Tag archives -> Hugo tags (slug preserved) ---
@tag path_regexp tag ^/tag/([^/]+)/?$
redir @tag /tags/{re.tag.1}/ 301

# --- Category archives -> Hugo categories (slug preserved) ---
@category path_regexp cat ^/category/([^/]+)/?$
redir @category /categories/{re.cat.1}/ 301

# --- WordPress portfolio (projects) -> projects gallery ---
@portfolio path_regexp ^/(portfolio-item|portfolio-category)(/.*)?$
redir @portfolio /projects/ 301

# --- Old projects taxonomy, /our-work/, and defunct microsites -> projects gallery ---
# /projects/.+ requires a sub-path so the live /projects/ listing is untouched.
@oldprojects path_regexp ^/(projects/.+|our-work|our-work/.*|labs|labs/.*|mobile-for-museums|mobile-for-museums/.*|robertson|robertson/.*|courses|courses/.*)$
redir @oldprojects /projects/ 301

# --- 20th-anniversary microsite sub-pages -> our story ---
# (Bare /20th/ and /rrchnm20/ are handled by the map above.)
@anniversary path_regexp ^/(20th|rrchnm20)/.+
redir @anniversary /our-story/ 301
