# redirects.caddy — legacy URL redirects for rrchnm.org (301).
#
# Imported by the Caddyfile in the repo Dockerfile via `import /srv/redirects.caddy`.
# Hugo copies this file from static/ into public/, which ships as the deploy
# artifact and lands at /srv/redirects.caddy in the runtime image.
#
# Two mechanisms, evaluated in this order by Caddy (map runs before redir; the
# redir directives fire in source order, first match wins):
#   1. An exact-path `map` for one-off page moves, slug fixes, and the ~100
#      legacy WordPress project landing pages (all -> /projects/). Because this
#      block's redir is emitted first, its entries override the section
#      patterns below (e.g. the essay slug fixes beat the generic /essays/ rule).
#   2. `path_regexp` section patterns that preserve the slug across a whole
#      WordPress section (news -> blog, essays -> publications, etc.).
#
# Source of truth for the legacy inventory: the Wayback Machine capture of the
# pre-Hugo WordPress site (web.archive.org, host rrchnm.org). Note: only ~90 of
# the ~410 old /news/ posts exist in the current Hugo blog, so unmigrated
# /news/<slug> URLs 301 to a Hugo 404 — this matches the prior production rules.

map {path} {redirect_target} {
	default ""

	# --- About / organization pages -> /our-story/ ---
	/about /our-story/
	/about/ /our-story/
	/about-rrchnm /our-story/
	/about-rrchnm/ /our-story/
	/our-history /our-story/
	/our-history/ /our-story/
	/who-we-are /our-story/
	/who-we-are/ /our-story/
	/what-we-do /our-story/
	/what-we-do/ /our-story/
	/who-we-work-with /our-story/
	/who-we-work-with/ /our-story/
	/contact-us /our-story/
	/contact-us/ /our-story/
	/our-story/contact-us /our-story/
	/our-story/contact-us/ /our-story/
	/our-story/history /our-story/
	/our-story/history/ /our-story/
	/supporters /our-story/
	/supporters/ /our-story/
	/our-story/supporters /our-story/
	/our-story/supporters/ /our-story/
	/annual-report /our-story/
	/annual-report/ /our-story/
	/annual-reports /our-story/
	/annual-reports/ /our-story/
	/our-story/annual-reports /our-story/
	/our-story/annual-reports/ /our-story/
	/awards /our-story/
	/awards/ /our-story/
	/roy-rosenzweig-prize-recipients /our-story/
	/roy-rosenzweig-prize-recipients/ /our-story/
	/rrchnm20 /our-story/
	/rrchnm20/ /our-story/
	/jobs /our-story/
	/jobs/ /our-story/
	/collaborate /our-story/
	/collaborate/ /our-story/
	/circle /our-story/
	/circle/ /our-story/
	/requests /our-story/
	/requests/ /our-story/
	/donate /our-story/
	/donate/ /our-story/
	/donate-test /our-story/
	/donate-test/ /our-story/

	# --- People ---
	/our-people /people/
	/our-people/ /people/
	/chnmstaff /people/
	/chnmstaff/ /people/
	/affiliates /people/
	/affiliates/ /people/
	/affiliates-alumni /people/
	/affiliates-alumni/ /people/

	# --- Graduate education ---
	/digital-public-humanities-graduate-certificate /graduate-student-education/
	/digital-public-humanities-graduate-certificate/ /graduate-student-education/
	/apply-now-for-the-online-graduate-certificate-in-digital-public-humanities /graduate-student-education/
	/apply-now-for-the-online-graduate-certificate-in-digital-public-humanities/ /graduate-student-education/

	# --- Publications: "Digital History and Argument" white paper ---
	/argument-white-paper /publications/digital-history-and-argument-white-paper/
	/argument-white-paper/ /publications/digital-history-and-argument-white-paper/
	/argument-white--paper /publications/digital-history-and-argument-white-paper/
	/argument-white--paper/ /publications/digital-history-and-argument-white-paper/

	# --- Essay slug fixes (override the generic /essay(s)/<slug> pattern) ---
	/essays/american-digital-history-2 /publications/american-digital-history/
